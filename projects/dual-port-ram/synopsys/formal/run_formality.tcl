# Formality equivalence check: RTL reference versus DC mapped implementation.
# Run after synopsys/dc/run_dc.tcl has completed.

set SCRIPT_DIR  [file dirname [file normalize [info script]]]
set CONFIG_FILE [file normalize [file join $SCRIPT_DIR .. config technology_setup.tcl]]
if {![file readable $CONFIG_FILE]} {
    error "Missing $CONFIG_FILE. Copy technology_setup.tcl.template first."
}
source $CONFIG_FILE

proc require_readable {label path} {
    if {$path eq "" || ![file readable $path]} {
        error "$label is not readable: '$path'"
    }
}

set MAPPED_NETLIST [file join $PROJECT_ROOT synopsys dc output ${TOP_MODULE}_mapped.v]
set SVF_FILE       [file join $PROJECT_ROOT synopsys dc output ${TOP_MODULE}.svf]
set REPORT_DIR     [file join $PROJECT_ROOT synopsys formal reports]
file mkdir $REPORT_DIR

require_readable "Reference RTL" $RTL_FILE
require_readable "Implementation netlist" $MAPPED_NETLIST
require_readable "Target .db library" $TARGET_LIBRARY_FILE

# The .db is required on both sides because the implementation contains
# standard-cell instances. The SVF is generated by the matching DC run.
read_db -container r $TARGET_LIBRARY_FILE
read_db -container i $TARGET_LIBRARY_FILE
if {[file readable $SVF_FILE]} {
    set_svf $SVF_FILE
}

read_verilog -container r -libname WORK $RTL_FILE
set_top r:/WORK/$TOP_MODULE
read_verilog -container i -libname WORK $MAPPED_NETLIST
set_top i:/WORK/$TOP_MODULE

match
redirect -file [file join $REPORT_DIR ${TOP_MODULE}_unmatched.rpt] {
    report_unmatched_points
}
verify
redirect -file [file join $REPORT_DIR ${TOP_MODULE}_failing.rpt] {
    report_failing_points
}

puts "Formality completed. Inspect $REPORT_DIR for unmatched/failing-point reports."
quit
